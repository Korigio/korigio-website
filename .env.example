GITHUB_RELEASES_REPO=Korigio/korigio-downloads

# Feedback form — submissions are emailed to this inbox.
FEEDBACK_TO_EMAIL=info@korigio.com
FEEDBACK_FROM_EMAIL=Korigio <info@korigio.com>

# SMTP via the Strato mailbox (smtp.strato.de). Set these in Dokploy.
# SMTP_PASS is the mailbox password for info@korigio.com (not the Strato customer login).
SMTP_HOST=smtp.strato.de
SMTP_PORT=465
SMTP_USER=info@korigio.com
SMTP_PASS=

# Alternative: Resend (https://resend.com) instead of SMTP.
# RESEND_API_KEY=re_xxxxxxxx
